{
  "id": "ia-pro-service",
  "name": "プロフェッショナルサービス（受託/コンサル）",
  "description": "営業資料として読ませる構成。プロセス/不安解消/CTAを重視。",
  "recommendedFor": {
    "offeringType": [
      "service",
      "mixed"
    ],
    "trustRequirement": [
      "mid",
      "high"
    ],
    "contentVolume": [
      "mid",
      "high"
    ]
  },
  "pages": {
    "home": {
      "path": "/",
      "sections": [
        "hero",
        "serviceHighlights",
        "features",
        "proof",
        "cta",
        "footer"
      ],
      "requiredTextKeys": [
        "content.home.hero.headline",
        "content.home.hero.subheadline",
        "content.services.items"
      ],
      "requiredImageKeys": [
        "assets.logo.primary"
      ],
      "optionalTextKeys": [
        "content.home.proof.metrics"
      ],
      "optionalImageKeys": [
        "assets.hero.image"
      ]
    },
    "services": {
      "path": "/services",
      "sections": [
        "serviceGrid",
        "process",
        "faq",
        "cta",
        "footer"
      ],
      "requiredTextKeys": [
        "content.services.items"
      ],
      "requiredImageKeys": [],
      "optionalTextKeys": [
        "content.services.process.steps",
        "content.faq.items"
      ],
      "optionalImageKeys": []
    },
    "company": {
      "path": "/company",
      "sections": [
        "overview",
        "mvv",
        "profileTable",
        "ceoMessage",
        "footer"
      ],
      "requiredTextKeys": [
        "content.company.profile.legalName",
        "content.company.profile.address"
      ],
      "requiredImageKeys": [],
      "optionalTextKeys": [
        "content.company.mission",
        "content.company.values"
      ],
      "optionalImageKeys": [
        "assets.ceo.photo"
      ]
    },
    "contact": {
      "path": "/contact",
      "sections": [
        "contactInfo",
        "contactForm",
        "footer"
      ],
      "requiredTextKeys": [
        "content.contact.email"
      ],
      "requiredImageKeys": [],
      "optionalTextKeys": [
        "content.contact.form.fields"
      ],
      "optionalImageKeys": []
    },
    "privacy": {
      "path": "/privacy",
      "sections": [
        "legalBody",
        "footer"
      ],
      "requiredTextKeys": [
        "legal.privacyPolicy.body"
      ],
      "requiredImageKeys": [],
      "optionalTextKeys": [],
      "optionalImageKeys": []
    }
  },
  "defaults": {
    "navStyle": "standard"
  }
}