{
  "id": "theme-modern-saas",
  "name": "モダンSaaS（Bento）",
  "keywords": [
    "先進",
    "軽快",
    "モジュール",
    "UI"
  ],
  "defaults": {
    "design": {
      "stylePreset": "modern",
      "spacingDensity": "standard",
      "cornerRadius": "round",
      "shadowStrength": "soft"
    },
    "motion": {
      "intensity": "standard"
    },
    "imagery": {
      "mode": "mixed",
      "iconStyle": "outline",
      "illustrationStyle": "none",
      "photoTreatment": "natural"
    }
  },
  "tokens": {
    "light": {
      "background": "#ffffff",
      "foreground": "#0b1220",
      "card": "#ffffff",
      "cardForeground": "#0b1220",
      "popover": "#ffffff",
      "popoverForeground": "#0b1220",
      "primary": "#7c3aed",
      "primaryForeground": "#ffffff",
      "secondary": "#f1f5f9",
      "secondaryForeground": "#0b1220",
      "muted": "#f8fafc",
      "mutedForeground": "#475569",
      "accent": "#ede9fe",
      "accentForeground": "#5b21b6",
      "destructive": "#dc2626",
      "destructiveForeground": "#ffffff",
      "border": "#e2e8f0",
      "input": "#e2e8f0",
      "ring": "#7c3aed"
    },
    "dark": {
      "background": "#070a12",
      "foreground": "#e5e7eb",
      "card": "#0b1220",
      "cardForeground": "#e5e7eb",
      "popover": "#0b1220",
      "popoverForeground": "#e5e7eb",
      "primary": "#a78bfa",
      "primaryForeground": "#070a12",
      "secondary": "#111827",
      "secondaryForeground": "#e5e7eb",
      "muted": "#111827",
      "mutedForeground": "#9ca3af",
      "accent": "#312e81",
      "accentForeground": "#e5e7eb",
      "destructive": "#f87171",
      "destructiveForeground": "#070a12",
      "border": "#1f2937",
      "input": "#1f2937",
      "ring": "#a78bfa"
    }
  },
  "radius": "1rem",
  "fonts": {
    "sans": "ui-sans-serif, system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial",
    "heading": "ui-sans-serif, system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial"
  },
  "typography": {
    "baseFontSize": "md",
    "lineHeight": "normal",
    "tracking": "normal"
  }
}